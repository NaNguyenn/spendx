# Loaded by the integration suite (test/global-setup.ts) before anything opens a
# connection. Committed on purpose: it holds no secrets, and pinning it here is
# what guarantees a test run cannot truncate the development database.
#
# The database name MUST end in _test — test/global-setup.ts refuses to run
# otherwise.

NODE_ENV=test
PORT=3001

DATABASE_URL=postgres://spendx:spendx@localhost:55432/spendx_test

JWT_SECRET=test-secret
JWT_EXPIRES_IN=1h

RATE_LIMIT_MAX=100000
AUTH_RATE_LIMIT_MAX=100000
