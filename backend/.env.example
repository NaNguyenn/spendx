# Copy to .env (`make setup` does this for you) and adjust.
# Postgres comes from the root compose.yaml — see the root README.
#
# Every variable here is validated by src/config/env.schema.ts at boot: a
# missing or malformed value stops the process with a readable message rather
# than surfacing as undefined somewhere in a request.

NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://spendx:spendx@localhost:55432/spendx

# Signs and verifies session tokens (see src/auth). Any non-empty value works
# locally; use a real secret, kept out of source, in production.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=90d

# Per-minute request allowances (see src/app.module.ts). Effectively disabled
# in development; tightened for real deployments.
RATE_LIMIT_MAX=100000
AUTH_RATE_LIMIT_MAX=100000
