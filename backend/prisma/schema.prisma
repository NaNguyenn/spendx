// spendx domain schema. See backend/CONTEXT.md for the vocabulary and
// docs/adr/0005-prisma-as-the-persistence-layer.md for why Prisma.
//
// Money columns use Decimal (never Float) — the spec requires decimal-safe
// amounts end to end.

// Prisma 7 is ESM-first; this backend is CommonJS (Nest's default), so the
// generated client is emitted as CommonJS TypeScript with extensionless
// imports. The client lands under src/ so `nest build` compiles it into dist/.
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

/// One of the ≈10 curated currencies (see backend/CONTEXT.md — Supported
/// Currency) a User may pick for an Original Amount or as Preferred Currency.
/// Mirrors src/domain/currency.ts.
enum SupportedCurrency {
  VND
  USD
  EUR
  GBP
  JPY
  SGD
  AUD
  CAD
  KRW
  THB

  @@map("supported_currency")
}

/// A User's account-level language (see backend/CONTEXT.md — Locale). Mirrors
/// src/domain/locale.ts.
enum Locale {
  en
  vi

  @@map("locale")
}

/// One of the fixed, app-curated spending kinds (see backend/CONTEXT.md —
/// Category). Language-neutral slugs: labels are localized client-side, so
/// the API never returns a human label. Mirrors src/domain/category.ts.
///
/// Wire-form note (Category and Visibility share this convention): both are
/// app-invented vocabularies, not external standards like ISO currency codes,
/// so both use lower_snake_case slugs — distinct from SupportedCurrency's
/// uppercase ISO codes and consistent with Locale's lowercase codes, and
/// unambiguous for the multi-word case (`friend_only`).
enum Category {
  housing
  food
  leisure
  investment
  other

  @@map("category")
}

/// Who may see an Expense (see backend/CONTEXT.md — Visibility). See
/// Category above for the shared slug convention. Mirrors
/// src/domain/visibility.ts.
enum Visibility {
  private
  friend_only
  public

  @@map("visibility")
}

/// What a One-Time Code proves (see backend/CONTEXT.md — One-Time Code):
/// Email Verification or Password Reset. See Category above for the shared
/// slug convention. Mirrors src/domain/one-time-code-purpose.ts.
enum OneTimeCodePurpose {
  email_verification
  password_reset

  @@map("one_time_code_purpose")
}

/// A person with a spendx account.
///
/// `passwordHash` is a self-describing scrypt string (see
/// src/auth/scrypt-password-hasher.ts); the password itself is never stored.
/// `preferredCurrency` and `locale` are the account-level Preferred Currency
/// and Locale a User picks at sign-up. `emailVerifiedAt` is set once by
/// EmailVerificationService on a confirmed One-Time Code (backend/CONTEXT.md
/// — Email Verification); null means unverified, which gates nothing —
/// the state is visible only to the owner (PrivateUserDto), never on
/// PublicUserDto.
model User {
  id                String            @id @default(uuid(7))
  email             String            @unique
  username          String            @unique
  displayName       String
  passwordHash      String
  preferredCurrency SupportedCurrency
  locale            Locale
  emailVerifiedAt   DateTime?
  /// When this User's credentials last changed (docs/adr/0010): the auth
  /// guard rejects any token issued before it, which is how completing a
  /// Password Reset ends every existing session. Null — the state of every
  /// pre-existing account — means "never", so all tokens pass.
  credentialsChangedAt DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  expenses Expense[]

  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  friendshipsAsUserA     Friendship[]    @relation("FriendshipsAsUserA")
  friendshipsAsUserB     Friendship[]    @relation("FriendshipsAsUserB")
  likes                  Like[]
  blocksMade             Block[]         @relation("BlocksMade")
  blocksReceived         Block[]         @relation("BlocksReceived")
  oneTimeCodes           OneTimeCode[]

  @@map("users")
}

/// A single spending record logged by a User (see backend/CONTEXT.md —
/// Expense). See docs/adr/0002 and 0008 for the conversion model this
/// schema implements.
///
/// `originalAmount`/`originalCurrency` are the Original Amount exactly as
/// entered — immutable after logging (ADR-0008): edits touch only
/// description, category, visibility, and `expenseDate`. `conversions` is
/// the Conversion Snapshot; `loggedAt` anchors its rates and is immutable;
/// `expenseDate` drives grouping only and never affects conversion
/// (ADR-0002).
///
/// Money columns are Decimal(20,4): up to 16 integer digits and 4 decimal
/// places, generous enough for VND-scale amounts without ever being a Float.
model Expense {
  id               String            @id @default(uuid(7))
  ownerId          String
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  description      String
  originalAmount   Decimal           @db.Decimal(20, 4)
  originalCurrency SupportedCurrency
  category         Category
  visibility       Visibility
  expenseDate      DateTime          @db.Date
  loggedAt         DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  conversions ExpenseConversion[]
  likes       Like[]

  // Backs "list the owner's own expenses, newest first" (GET /expenses).
  @@index([ownerId, loggedAt])
  // Backs personal statistics (GET /expenses/statistics, issue #7), which
  // groups by Expense Date, never Logged At.
  @@index([ownerId, expenseDate])
  // Backs the Feed (GET /feed, issue #13): every Public Expense, newest
  // first by Logged At, keyset-paginated on (loggedAt, id). visibility
  // leads so the index only ever scans Public rows; loggedAt then id
  // matches ORDER BY and the cursor predicate exactly.
  @@index([visibility, loggedAt, id])
  @@map("expenses")
}

/// One entry of an Expense's Conversion Snapshot (see backend/CONTEXT.md and
/// ADR-0008): the Original Amount in `currency`, derived at the Daily Rate
/// of the logging date and frozen. Written all-or-nothing with the Expense —
/// every Supported Currency has a row, always — and never updated: the
/// Original Amount is immutable, so the snapshot is write-once and dies with
/// its Expense.
model ExpenseConversion {
  expenseId String
  expense   Expense           @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  currency  SupportedCurrency
  amount    Decimal           @db.Decimal(20, 4)

  @@id([expenseId, currency])
  @@map("expense_conversions")
}

/// The exchange rate for a currency pair on a calendar date (see
/// backend/CONTEXT.md — Daily Rate), snapshotted once daily from an external
/// provider into this table — conversion (src/daily-rates/conversion.service.ts)
/// only ever reads this table, never the provider, per ADR-0001.
///
/// `rate` is quote-per-base: `amount(baseCurrency) * rate = amount(quoteCurrency)`.
/// The unique index on (base, quote, date) is also the index the "most recent
/// rate on or before this date" fallback scans — base and quote pin an exact
/// equality prefix, and rate_date sorts last, so `ORDER BY rate_date DESC
/// LIMIT 1` is a cheap ordered scan of that index rather than a table scan.
model DailyRate {
  id            String            @id @default(uuid(7))
  baseCurrency  SupportedCurrency
  quoteCurrency SupportedCurrency
  rateDate      DateTime          @db.Date
  // Generous scale: JPY/VND-scale rates need headroom on both sides of the
  // point that a 4-decimal money column doesn't.
  rate          Decimal           @db.Decimal(24, 10)
  createdAt     DateTime          @default(now())

  @@unique([baseCurrency, quoteCurrency, rateDate])
  @@map("daily_rates")
}

/// A pending offer of Friendship from one User to another (see
/// backend/CONTEXT.md — Friend Request). A row exists only while the offer
/// is pending — there is deliberately no status column: accepting
/// (FriendRequestsRepository.accept) deletes the row and creates the
/// matching Friendship in one transaction; declining or cancelling just
/// deletes it.
///
/// `@@unique([senderId, recipientId])` blocks a duplicate in the same
/// direction; the reverse direction is a business rule the service checks
/// before creating one (a User pair may have at most one pending request
/// regardless of who sent it).
model FriendRequest {
  id          String @id @default(uuid(7))
  senderId    String
  sender      User   @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User   @relation("ReceivedFriendRequests", fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([senderId, recipientId])
  @@map("friend_requests")
}

/// A mutual, consented relationship between two Users (see
/// backend/CONTEXT.md — Friendship): both sides see each other's
/// Friend-only Expenses. Created only by
/// FriendRequestsRepository.accept — never directly.
///
/// `userAId` and `userBId` are canonically ordered (userAId < userBId,
/// enforced in code — see friends/friend-pair.ts) so each unordered pair of
/// Users maps to exactly one row regardless of who sent the original Friend
/// Request, and `@@unique([userAId, userBId])` actually prevents a
/// duplicate rather than missing the mirrored pair.
model Friendship {
  id      String @id @default(uuid(7))
  userAId String
  userA   User   @relation("FriendshipsAsUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId String
  userB   User   @relation("FriendshipsAsUserB", fields: [userBId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  // Backs "list my Friends": a User can be stored as either userA or userB,
  // so both sides need to resolve back to their Friendships. userAId is
  // already covered by the unique index above.
  @@index([userBId])
  @@map("friendships")
}

/// A User's endorsement of an Expense they can see (see backend/CONTEXT.md —
/// Like): visible ⇒ likeable — the count and likers are visible to exactly
/// those who can see the Expense. The one Visibility check every route
/// shares lives in LikesService, not here or in the schema; a Like from a
/// viewer later excluded by a Visibility change deliberately survives —
/// only `onDelete: Cascade` from User or Expense removes a row, never a
/// Visibility edit.
model Like {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, expenseId])
  // Backs "this Expense's Like count and likers, newest first"
  // (GET /expenses/:id/likes and the likeCount/likedByViewer enrichment on
  // ExpenseDto) — userId_expenseId above already covers the reverse lookup.
  @@index([expenseId])
  @@map("likes")
}

/// Full mutual invisibility between two Users, initiated by one of them (see
/// backend/CONTEXT.md — Block): neither sees the other's content anywhere,
/// neither can send a Friend Request, and any existing Friendship is
/// severed. Directional — `blockerId` is who initiated it and owns the
/// blocked-list entry (only they may see it via GET /blocks or remove it via
/// DELETE /blocks/:username) — but the filter it drives
/// (BlocksRepository.invisibleUserIdsFor) is applied both ways: a Block row
/// makes each side invisible to the other, regardless of who blocked whom.
/// `onDelete: Cascade` on both sides — a deleted account takes every Block
/// naming it with it, same as every other social-graph model here.
model Block {
  id        String @id @default(uuid(7))
  blockerId String
  blocker   User   @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User   @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  // Backs the reverse-direction half of "invisible to viewer X": rows where
  // X is the one blocked. blockerId is already covered by the unique index
  // above.
  @@index([blockedId])
  @@map("blocks")
}

/// A 6-digit One-Time Code emailed to a User to prove control of their email
/// address (see backend/CONTEXT.md — One-Time Code), for exactly one
/// Purpose: Email Verification or Password Reset. Purpose-generic machinery
/// (src/one-time-codes) shared by both flows — neither flow's own module
/// owns this table.
///
/// `codeHash` is a scrypt hash (src/auth/scrypt-password-hasher.ts) — the
/// plain code is never persisted, only handed back once to the caller that
/// issued it. `@@unique([userId, purpose])` makes "the live code for this
/// User and Purpose" structurally a single row: issuing a new one is an
/// upsert over whatever was there, which is newest-wins invalidation by
/// construction rather than a status flag. `createdAt` has no `@default` —
/// OneTimeCodesService supplies it from the injected CLOCK, so both the
/// 60-second issue cooldown and `expiresAt` are computed from, and testable
/// against, the same clock as everything else (src/clock). `failedAttempts`
/// reaching 5 kills the code even to the correct value — confirming deletes
/// the row on success (single-use) or increments this on a mismatch.
model OneTimeCode {
  id             String             @id @default(uuid(7))
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose        OneTimeCodePurpose
  codeHash       String
  failedAttempts Int                @default(0)
  createdAt      DateTime
  expiresAt      DateTime

  @@unique([userId, purpose])
  @@map("one_time_codes")
}
