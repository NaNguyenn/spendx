// spendx domain schema. See backend/CONTEXT.md for the vocabulary and
// docs/adr/0005-prisma-as-the-persistence-layer.md for why Prisma.
//
// Money columns use Decimal (never Float) — the spec requires decimal-safe
// amounts end to end.

// Prisma 7 is ESM-first; this backend is CommonJS (Nest's default), so the
// generated client is emitted as CommonJS TypeScript with extensionless
// imports. The client lands under src/ so `nest build` compiles it into dist/.
generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

datasource db {
  provider = "postgresql"
}

/// A person with a spendx account.
///
/// Skeleton only: this table exists so the development environment (#18) can
/// prove migrate → seed → test → truncate end to end. Authentication columns
/// (password hash, verification state, sessions) and the account settings
/// Preferred Currency and Locale belong to #2 and are added there.
model User {
  id          String   @id @default(uuid(7))
  email       String   @unique
  username    String   @unique
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}
