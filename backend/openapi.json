{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Round-trips a query to Postgres, so a green response means the connection is genuinely usable rather than merely configured.",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailableDto"
                }
              }
            }
          }
        },
        "summary": "Liveness of the API and its database",
        "tags": ["health"]
      }
    },
    "/users/me": {
      "get": {
        "operationId": "UsersController_getMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivateUserDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The caller's own account",
        "tags": ["users"]
      },
      "patch": {
        "operationId": "UsersController_updateMe",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrivateUserDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update the caller's own account",
        "tags": ["users"]
      }
    },
    "/users/{username}": {
      "get": {
        "description": "Exact match only — see backend/CONTEXT.md on Username.",
        "operationId": "UsersController_getByUsername",
        "parameters": [
          {
            "name": "username",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicUserDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Look up a User by Username",
        "tags": ["users"]
      }
    },
    "/auth/sign-up": {
      "post": {
        "description": "Works immediately — there is no verification gate.",
        "operationId": "AuthController_signUp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignUpDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "409": {
            "description": "Email or Username already taken"
          }
        },
        "summary": "Create an account",
        "tags": ["auth"]
      }
    },
    "/auth/sign-in": {
      "post": {
        "operationId": "AuthController_signIn",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password"
          }
        },
        "summary": "Start a token session",
        "tags": ["auth"]
      }
    },
    "/expenses": {
      "post": {
        "operationId": "ExpensesController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExpenseDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Log an Expense",
        "tags": ["expenses"]
      },
      "get": {
        "description": "Every Visibility, newest logged first. Owner-only for now.",
        "operationId": "ExpensesController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExpenseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The caller's own Expenses",
        "tags": ["expenses"]
      }
    },
    "/expenses/statistics": {
      "get": {
        "description": "Current-ISO-week and current-calendar-month totals and Category breakdowns, each against the immediately preceding Period, in the caller's Preferred Currency. Owner-scoped over every Visibility — full spending appears only here (ADR-0003).",
        "operationId": "ExpensesController_statistics",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatisticsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The caller's personal statistics",
        "tags": ["expenses"]
      }
    },
    "/expenses/{id}": {
      "patch": {
        "description": "Owner-only. The Converted Amount is re-derived at the original logging date's Daily Rate, never the edit date's (ADR-0002).",
        "operationId": "ExpensesController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateExpenseDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseDto"
                }
              }
            }
          },
          "404": {
            "description": "Not the caller's Expense, or no such Expense."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Edit an Expense",
        "tags": ["expenses"]
      },
      "delete": {
        "description": "Owner-only. Removes it everywhere, with no residue.",
        "operationId": "ExpensesController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "404": {
            "description": "Not the caller's Expense, or no such Expense."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Delete an Expense",
        "tags": ["expenses"]
      }
    }
  },
  "info": {
    "title": "spendx API",
    "description": "The API owning the spendx domain model: users, expenses, and the social graph between them.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"],
            "example": "ok"
          },
          "database": {
            "type": "string",
            "enum": ["up"],
            "example": "up"
          }
        },
        "required": ["status", "database"]
      },
      "HealthUnavailableDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["error"],
            "example": "error"
          },
          "database": {
            "type": "string",
            "enum": ["down"],
            "example": "down"
          }
        },
        "required": ["status", "database"]
      },
      "SupportedCurrency": {
        "type": "string",
        "enum": [
          "VND",
          "USD",
          "EUR",
          "GBP",
          "JPY",
          "SGD",
          "AUD",
          "CAD",
          "KRW",
          "THB"
        ]
      },
      "Locale": {
        "type": "string",
        "enum": ["en", "vi"]
      },
      "PrivateUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string",
            "description": "The User's unique public handle."
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "preferredCurrency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SupportedCurrency"
              }
            ]
          },
          "locale": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Locale"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "description": "ISO 8601"
          }
        },
        "required": [
          "id",
          "username",
          "displayName",
          "email",
          "preferredCurrency",
          "locale",
          "createdAt"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "locale": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Locale"
              }
            ]
          }
        },
        "required": ["locale"]
      },
      "PublicUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string",
            "description": "The User's unique public handle."
          },
          "displayName": {
            "type": "string"
          }
        },
        "required": ["id", "username", "displayName"]
      },
      "SignUpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "minh@spendx.app"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "username": {
            "type": "string",
            "example": "minhtran",
            "description": "The User's unique public handle: 3-30 characters, lowercase letters, digits, and underscores."
          },
          "displayName": {
            "type": "string",
            "example": "Minh Trần"
          },
          "preferredCurrency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SupportedCurrency"
              }
            ]
          },
          "locale": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Locale"
              }
            ]
          }
        },
        "required": [
          "email",
          "password",
          "username",
          "displayName",
          "preferredCurrency",
          "locale"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/PrivateUserDto"
          }
        },
        "required": ["accessToken", "user"]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "minh@spendx.app"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["email", "password"]
      },
      "Category": {
        "type": "string",
        "enum": ["housing", "food", "leisure", "investment", "other"]
      },
      "Visibility": {
        "type": "string",
        "enum": ["private", "friend_only", "public"]
      },
      "CreateExpenseDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "example": "Coffee with a friend"
          },
          "originalAmount": {
            "type": "string",
            "example": "45000.0000",
            "description": "The Original Amount, exactly as entered: a positive decimal string with at most 4 decimal places. Never a JSON number."
          },
          "originalCurrency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SupportedCurrency"
              }
            ]
          },
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Category"
              }
            ]
          },
          "visibility": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Visibility"
              }
            ]
          },
          "expenseDate": {
            "type": "string",
            "example": "2026-08-01",
            "description": "The Expense Date (YYYY-MM-DD). Defaults to the logging day in the fixed app timezone (Asia/Ho_Chi_Minh) when omitted. Backdating is allowed; this never affects the Converted Amount (ADR-0002)."
          }
        },
        "required": [
          "description",
          "originalAmount",
          "originalCurrency",
          "category",
          "visibility"
        ]
      },
      "ExpenseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "originalAmount": {
            "type": "string",
            "description": "The Original Amount, exactly as entered and immutable after logging (ADR-0008), as a fixed-scale decimal string (4 decimal places). Never a JSON number.",
            "example": "45000.0000"
          },
          "originalCurrency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SupportedCurrency"
              }
            ]
          },
          "convertedAmount": {
            "type": "string",
            "description": "The Converted Amount: the Conversion Snapshot's entry for the reader's Preferred Currency — derived at the logging date's Daily Rate and frozen (ADR-0008). A fixed-scale decimal string (4 decimal places).",
            "example": "1.9565"
          },
          "convertedCurrency": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SupportedCurrency"
              }
            ]
          },
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Category"
              }
            ]
          },
          "visibility": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Visibility"
              }
            ]
          },
          "expenseDate": {
            "type": "string",
            "description": "YYYY-MM-DD",
            "example": "2026-08-01"
          },
          "loggedAt": {
            "type": "string",
            "description": "ISO 8601 — the immutable Logged At."
          }
        },
        "required": [
          "id",
          "description",
          "originalAmount",
          "originalCurrency",
          "convertedAmount",
          "convertedCurrency",
          "category",
          "visibility",
          "expenseDate",
          "loggedAt"
        ]
      },
      "CategoryTotalDto": {
        "type": "object",
        "properties": {
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Category"
              }
            ]
          },
          "total": {
            "type": "string",
            "description": "The summed Converted Amount for this Category within the Period, in the owner's Preferred Currency, as a fixed-scale decimal string (4 decimal places). Never a JSON number.",
            "example": "450000.0000"
          }
        },
        "required": ["category", "total"]
      },
      "PeriodStatisticsDto": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "description": "YYYY-MM-DD, inclusive.",
            "example": "2026-08-03"
          },
          "end": {
            "type": "string",
            "description": "YYYY-MM-DD, inclusive.",
            "example": "2026-08-09"
          },
          "total": {
            "type": "string",
            "description": "The summed Converted Amount over the Period, in the owner's Preferred Currency, as a fixed-scale decimal string (4 decimal places). Never a JSON number.",
            "example": "4850000.0000"
          },
          "previousTotal": {
            "type": "string",
            "description": "The same total for the immediately preceding Period of the same length (previous ISO week or previous calendar month), for comparison.",
            "example": "3200000.0000"
          },
          "categories": {
            "description": "Every Category (backend/CONTEXT.md), including zero totals, sorted by total descending; ties broken by the canonical Category order.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryTotalDto"
            }
          }
        },
        "required": ["start", "end", "total", "previousTotal", "categories"]
      },
      "StatisticsDto": {
        "type": "object",
        "properties": {
          "currency": {
            "description": "The owner's Preferred Currency — every total below is in it.",
            "allOf": [
              {
                "$ref": "#/components/schemas/SupportedCurrency"
              }
            ]
          },
          "week": {
            "description": "The current ISO week (Monday through Sunday).",
            "allOf": [
              {
                "$ref": "#/components/schemas/PeriodStatisticsDto"
              }
            ]
          },
          "month": {
            "description": "The current calendar month.",
            "allOf": [
              {
                "$ref": "#/components/schemas/PeriodStatisticsDto"
              }
            ]
          }
        },
        "required": ["currency", "week", "month"]
      },
      "UpdateExpenseDto": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "example": "Coffee with a friend"
          },
          "category": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Category"
              }
            ]
          },
          "visibility": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Visibility"
              }
            ]
          },
          "expenseDate": {
            "type": "string",
            "example": "2026-08-01",
            "description": "The Expense Date (YYYY-MM-DD). Defaults to the logging day in the fixed app timezone (Asia/Ho_Chi_Minh) when omitted. Backdating is allowed; this never affects the Converted Amount (ADR-0002)."
          }
        }
      }
    }
  }
}
