        "tags": ["expenses"]
      },
      "get": {
        "description": "Every Visibility, newest logged first. Owner-only for now.",
        "operationId": "ExpensesController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExpenseDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The caller's own Expenses",
        "tags": ["expenses"]
      }
    },
    "/expenses/statistics": {
      "get": {
        "description": "Current-ISO-week and current-calendar-month totals and Category breakdowns, each against the immediately preceding Period, in the caller's Preferred Currency. Owner-scoped over every Visibility — full spending appears only here (ADR-0003).",
        "operationId": "ExpensesController_statistics",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatisticsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The caller's personal statistics",
        "tags": ["expenses"]
      }
    },
    "/expenses/{id}": {
      "patch": {
        "description": "Owner-only. The Converted Amount is re-derived at the original logging date's Daily Rate, never the edit date's (ADR-0002).",
        "operationId": "ExpensesController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateExpenseDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseDto"
                }
              }
            }
          },
          "404": {
            "description": "Not the caller's Expense, or no such Expense."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Edit an Expense",
        "tags": ["expenses"]
      },
      "delete": {
        "description": "Owner-only. Removes it everywhere, with no residue.",
        "operationId": "ExpensesController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "404": {
            "description": "Not the caller's Expense, or no such Expense."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Delete an Expense",
        "tags": ["expenses"]
      }
    },
    "/friend-requests": {
      "post": {
        "description": "See backend/CONTEXT.md — Friend Request.",
        "operationId": "FriendRequestsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFriendRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FriendRequestDto"
                }
              }
            }
          },
          "400": {
            "description": "Sending to yourself."
          },
          "404": {
            "description": "Unknown Username."
          },
          "409": {
            "description": "Already Friends, or a Friend Request is already pending between the two, in either direction."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Send a Friend Request",
        "tags": ["friends"]
      },
      "get": {
        "description": "Both directions, each newest first.",
        "operationId": "FriendRequestsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FriendRequestsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The caller's pending Friend Requests",
        "tags": ["friends"]
      }
    },
    "/friend-requests/{id}/accept": {
      "post": {
        "description": "Recipient only. Creates the Friendship.",
        "operationId": "FriendRequestsController_accept",
        "parameters": [
