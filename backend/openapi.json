    "/friends/{username}": {
      "delete": {
        "operationId": "FriendshipsController_remove",
        "parameters": [
          {
            "name": "username",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Unfriended."
          },
          "404": {
            "description": "No such Friendship."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Unfriend a User",
        "tags": ["friends"]
      }
    },
    "/users/{username}/expenses": {
      "get": {
        "description": "Friend-only and Public Expenses only, never Private — newest logged first, converted into the caller's own Preferred Currency. Requires an existing Friendship with the owner. Optionally narrowed to a Period via `start`/`end` (each independent and inclusive, by Expense Date) — how the Leaderboard drills into a past Period.",
        "operationId": "UserExpensesController_findAll",
        "parameters": [
          {
            "name": "username",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start",
            "required": false,
            "in": "query",
            "description": "Only Expenses whose Expense Date is on or after this date (YYYY-MM-DD), inclusive. Independent of `end`.",
            "schema": {
              "example": "2026-08-03",
              "type": "string"
            }
          },
          {
            "name": "end",
            "required": false,
            "in": "query",
            "description": "Only Expenses whose Expense Date is on or before this date (YYYY-MM-DD), inclusive. Independent of `start`.",
            "schema": {
              "example": "2026-08-09",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExpenseDto"
                  }
                }
              }
            }
          },
          "403": {
            "description": "Not Friends with this User (including a declined/cancelled Friend Request, an unfriended former Friend, or the caller's own Username)."
          },
          "404": {
            "description": "Unknown Username."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "A Friend's Shareable Expenses",
        "tags": ["friends"]
      }
    },
    "/leaderboard": {
      "get": {
        "description": "Ranks the caller and every one of their Friends by Shareable Spend (Friend-only and Public Expenses, never Private — even the caller's own row) within one Period, in the caller's Preferred Currency. Every Friend appears, zero-filled when they have no matching Expenses (ADR-0003). Defaults to the current ISO week; `anchor` browses any past Period.",
        "operationId": "LeaderboardController_get",
        "parameters": [
          {
            "name": "period",
            "required": false,
            "in": "query",
            "description": "The Period to rank. Defaults to the current ISO week.",
            "schema": {
              "$ref": "#/components/schemas/Period"
            }
          },
          {
            "name": "anchor",
            "required": false,
            "in": "query",
            "description": "Any calendar date (YYYY-MM-DD) inside the desired Period — the response covers the ISO week or calendar month containing it, letting a caller browse a past Period. Defaults to today's date in the fixed app timezone (Asia/Ho_Chi_Minh, ADR-0004).",
            "schema": {
              "example": "2026-08-05",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeaderboardDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid `period` or `anchor`."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The Leaderboard: the caller and every Friend by Shareable Spend",
        "tags": ["leaderboard"]
      }
    },
    "/feed": {
      "get": {
        "description": "Every Public Expense app-wide — including the caller's own — newest first by Logged At, each converted into the caller's own Preferred Currency via its frozen Conversion Snapshot (ADR-0008). Friend-only and Private Expenses never appear, regardless of Friendship. Block filtering (backend/CONTEXT.md — Block, issue #15) is not applied here yet — every Public Expense is visible to every caller for now. Keyset-paginated: pass a previous page's `nextCursor` to continue.",
        "operationId": "FeedController_get",
        "parameters": [
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Opaque pagination token from a previous page's `nextCursor`. Omit for the first page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Page size, 1-50. Defaults to 20.",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedPageDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid `limit`, or a malformed `cursor`."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The Feed: every Public Expense app-wide, newest first",
        "tags": ["feed"]
      }
    },
    "/expenses/{id}/like": {
      "put": {
        "description": "Visible ⇒ likeable (backend/CONTEXT.md — Like): the caller may Like any Expense they can see — their own, any Public Expense, or a Friend's Friend-only Expense. Idempotent: liking an already-liked Expense stays a single Like.",
        "operationId": "LikesController_like",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Liked (or already was)."
          },
          "404": {
            "description": "No such Expense, or the caller cannot see it."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Like an Expense",
        "tags": ["likes"]
      },
      "delete": {
        "description": "Idempotent: 204s even when the caller had not Liked it.",
        "operationId": "LikesController_unlike",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Unliked (or already was not)."
          },
          "404": {
            "description": "No such Expense, or the caller cannot see it."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Unlike an Expense",
        "tags": ["likes"]
      }
    },
    "/expenses/{id}/likes": {
      "get": {
        "description": "The likers, newest Like first, visible to exactly those who can see the Expense (backend/CONTEXT.md — Like).",
        "operationId": "LikesController_findLikers",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicUserDto"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such Expense, or the caller cannot see it."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Who liked this Expense",
        "tags": ["likes"]
      }
    }
  },
  "info": {
    "title": "spendx API",
    "description": "The API owning the spendx domain model: users, expenses, and the social graph between them.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"],
            "example": "ok"
          },
          "database": {
            "type": "string",
            "enum": ["up"],
            "example": "up"
          }
        },
        "required": ["status", "database"]
      },
      "HealthUnavailableDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["error"],
            "example": "error"
          },
          "database": {
            "type": "string",
            "enum": ["down"],
            "example": "down"
          }
        },
        "required": ["status", "database"]
      },
      "CreateBlockDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "minhtran",
            "description": "The Username to Block — exact match only, same as GET /users/:username (see backend/CONTEXT.md — Username)."
          }
        },
        "required": ["username"]
      },
      "PublicUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string",
            "description": "The User's unique public handle."
