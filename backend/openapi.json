{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Round-trips a query to Postgres, so a green response means the connection is genuinely usable rather than merely configured.",
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailableDto"
                }
              }
            }
          }
        },
        "summary": "Liveness of the API and its database",
        "tags": ["health"]
      }
    },
    "/blocks": {
      "post": {
        "description": "See backend/CONTEXT.md — Block.",
        "operationId": "BlocksController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBlockDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BlockDto"
                }
              }
            }
          },
          "400": {
            "description": "Blocking yourself."
          },
          "404": {
            "description": "Unknown Username, or the target has already blocked the caller (same response either way — no signal)."
          },
          "409": {
            "description": "Already blocked."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Block a User",
        "tags": ["blocks"]
      },
      "get": {
        "description": "Newest first.",
        "operationId": "BlocksController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicUserDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "The caller's blocked list",
        "tags": ["blocks"]
      }
    },
    "/blocks/{username}": {
      "delete": {
        "description": "Restores visibility both ways, but not any severed Friendship — see backend/CONTEXT.md — Block.",
        "operationId": "BlocksController_remove",
        "parameters": [
          {
            "name": "username",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Unblocked."
          },
          "404": {
            "description": "No such Block."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Unblock a User",
        "tags": ["blocks"]
      }
    },
