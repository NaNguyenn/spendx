      }
    },
    "/friends": {
      "get": {
        "description": "Ordered by Username. See backend/CONTEXT.md — Friendship.",
        "operationId": "FriendshipsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PublicUserDto"
                  }
                }
              }
