          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Accept a Friend Request",
        "tags": ["friends"]
      }
    },
    "/friend-requests/{id}": {
      "delete": {
        "description": "The recipient declines or the sender cancels — the same endpoint, role checked.",
        "operationId": "FriendRequestsController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
